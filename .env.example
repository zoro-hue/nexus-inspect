# Copy to .env and edit. server.py does not load this file automatically: export the variables in your shell
# or your process manager. Every value here is a placeholder; never commit a real key.

# AI Provider Configuration (Optional).
# NEXUS uses Google Gemini API as its primary and default provider.
# Also supports "anthropic" and "openai".
# If NEXUS_AI_API_KEY is unset, deterministic finding explanations and rule-based assistant remain fully functional.
NEXUS_AI_PROVIDER=gemini
NEXUS_AI_API_KEY=
NEXUS_AI_MODEL=gemini-2.0-flash

# SQLite database location (default: data/nexus.sqlite).
NEXUS_DB=

# Set to 1 when the site is served over HTTPS so session cookies carry the Secure flag.
NEXUS_COOKIE_SECURE=0

# Maximum analyses running at once across all accounts (default 8). Excess requests receive 503 server_busy.
NEXUS_MAX_ACTIVE_ANALYSES=8

# GitHub Personal Access Token (Optional).
# Used to authenticate GitHub REST API requests, increasing rate limits from 60 to 5,000 requests/hour.
# If unset or rate-limited, NEXUS INSPECT falls back to Git transport (git ls-remote).
GITHUB_TOKEN=

# Network binding (defaults: 0.0.0.0 and 8000).
HOST=0.0.0.0
PORT=8000
